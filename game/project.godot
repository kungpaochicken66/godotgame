; Engine configuration file.
; Godot 4.7.2 project for the Lantern Lane iPad game.

config_version=5

[application]

config/name="Lantern Lane"
config/description="A cozy shared town that 2-4 friends decorate together."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/name_localized={
"de": "Laternengasse",
"es": "Calle de los Farolillos",
"fr": "Rue des Lanternes",
"ja": "ランタン通り",
"zh_CN": "灯笼小巷"
}
boot_splash/bg_color=Color(0.96, 0.945, 0.906, 1)
boot_splash/show_image=false

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
Session="*res://scripts/net/session.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.96, 0.945, 0.906, 1)
