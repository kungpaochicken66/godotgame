+#ifdef TVOS_ENABLED
+	// With quit_on_go_back, a Menu press goes to UIKit from its beginning: UIKit needs the whole press
+	// (began and ended), not only its end, to return to the Home screen.
+	for (UIPress *press in presses) {
+		if (press.type == UIPressTypeMenu) {
+			SceneTree *scene = SceneTree::get_singleton();
+			if (scene && scene->is_quit_on_go_back()) {
+				tvos_menu_to_uikit = true;
+				print_line("[tvOS Menu] began: forwarded to UIKit");
+				[super pressesBegan:presses withEvent:event];
+				return;
+			}
+		}
+	}
+#endif
+
 	if (!DisplayServerAppleEmbedded::get_singleton() || DisplayServerAppleEmbedded::get_singleton()->is_keyboard_active()) {
 		return;
 	}
